  "version": "2.1.2",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=18.17.0"
  },
  "author": "lumia1998 (Koishi port)",
  "contributors": [
    "小鲸鱼 (original 鱼鱼找鸡, MIT)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumia1998/koishi-plugin-bitchfinder.git"
  },
  "homepage": "https://github.com/lumia1998/koishi-plugin-bitchfinder#readme",
  "bugs": {
    "url": "https://github.com/lumia1998/koishi-plugin-bitchfinder/issues"
  },
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "reverse-image-search",
    "coser",
    "google-lens",
    "saucenao",
    "tracemoe",
    "puppeteer",
    "chatluna"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "clean": "rimraf lib",
    "test": "npm run build && node --test test/differential.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@langchain/core": "^0.3.62",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "koishi": "^4.18.9",
    "koishi-plugin-chatluna": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "koishi-plugin-chatluna": {
      "optional": true
    }
  },
  "devDependencies": {
    "@koishijs/plugin-mock": "^2.6.6",
    "@types/node": "^22.10.0",
    "koishi": "^4.18.9",
    "koishi-plugin-chatluna": "^1.4.4",
    "koishi-plugin-puppeteer": "^3.9.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.9.3"
  },
  "koishi": {
    "description": {
      "zh": "鱼鱼找鸡：引用一张图发「找鸡」，多引擎反查 coser 的社媒账号（谷歌 Lens / SauceNAO / trace.moe）。可选注册 ChatLuna 工具 findbitch。"
    },
    "service": {
      "required": [
        "puppeteer"
      ],
      "optional": [
        "chatluna"
      ],
      "implements": []
    }
  }
