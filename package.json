{
  "name": "koishi-plugin-bitchfinder",
  "description": "根据图片和用户名找鸡和鉴别鸡：图片反查 coser/博主社媒账号，用户名鉴定 X 账号可信度与烧鸡榜",
  "version": "2.3.0",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=18.17.0"
  },
  "author": "lumia1998 (Koishi port)",
  "contributors": [
    "鱼鱼找鸡 v1.0.0 (original find algorithm, MIT)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumia1998/koishi-plugin-bitchfinder.git"
  },
  "homepage": "https://github.com/lumia1998/koishi-plugin-bitchfinder#readme",
  "bugs": {
    "url": "https://github.com/lumia1998/koishi-plugin-bitchfinder/issues"
  },
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "reverse-image-search",
    "coser",
    "google-lens",
    "saucenao",
    "tracemoe",
    "puppeteer",
    "chatluna",
    "xai",
    "twitter",
    "trust-check"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "clean": "rimraf lib",
    "test": "npm run build && node --test test/differential.test.mjs test/check.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@langchain/core": "^0.3.62",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "koishi": "^4.18.9",
    "koishi-plugin-chatluna": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "koishi-plugin-chatluna": {
      "optional": true
    }
  },
  "devDependencies": {
    "@koishijs/plugin-mock": "^2.6.6",
    "@types/node": "^22.10.0",
    "koishi": "^4.18.9",
    "koishi-plugin-chatluna": "^1.4.4",
    "koishi-plugin-puppeteer": "^3.9.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.9.3"
  },
  "koishi": {
    "description": {
      "zh": "根据图片和用户名找鸡和鉴别鸡：引用图片发「找鸡」，多引擎反查 coser/博主的社媒账号（谷歌 Lens / SauceNAO / trace.moe）；配 xAI Key 后可用「鉴定 @用户名」查 X 账号可信度与风险；「烧鸡榜」直接读 flj.info 的公开排行榜。可选注册 ChatLuna 工具 findbitch / checkbitch。"
    },
    "service": {
      "required": [
        "puppeteer"
      ],
      "optional": [
        "chatluna",
        "database"
      ],
      "implements": []
    }
  }
}
